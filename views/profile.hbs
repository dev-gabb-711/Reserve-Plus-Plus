<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{pageTitle}}</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
  <link rel="stylesheet" href="/css/profile.css">
</head>

<body class="page page--profile">
  <div class="app-bg"></div>

  <div class="page-wrap">
    <aside class="side-nav">
      <div class="side-icons">
        <button class="side-btn" type="button" onclick="location.href='/dashboard'">
          <span class="material-symbols-rounded">home</span>
        </button>
        <button class="side-btn" type="button" onclick="location.href='/reserve'">
          <span class="material-symbols-rounded">computer</span>
        </button>
        <button class="side-btn" type="button" onclick="location.href='/it-assist'">
          <span class="material-symbols-rounded">report</span>
        </button>
        <button class="side-btn" type="button" onclick="location.href='/notifications'">
          <span class="material-symbols-rounded">notifications</span>
        </button>
      </div>

      <div class="side-brand">
        <img src="/img/logo.png" class="brand-logo" alt="Logo">
      </div>
    </aside>

    <main class="main-area">
      <div class="top-row">
        <div>
          <h1 class="page-title">{{pageTitle}}</h1>
          <p class="page-subtitle">Welcome to your account center</p>
        </div>

        <div class="search-wrap">
          <div class="search-pill">
            <span class="search-ico">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
              </svg>
            </span>
            <input type="text" id="labSearch" placeholder="Search for Labs here...">
          </div>
        </div>
      </div>

      <div class="profile-shell {{#unless isOwner}}profile-shell--outsider{{/unless}}">
        {{#if isEditMode}}

          <div class="profile-grid">
            <div class="profile-left">
              <img
                id="avatarPreview"
                class="profile-avatar"
                src="{{profileUser.profilePic}}"
                alt="{{profileUser.fullName}}"
              >

              <div class="left-actions">
                <label class="btn-outline file-btn" for="avatarFile">Change Photo</label>
                <input id="avatarFile" class="file-input" type="file" accept="image/*">
              </div>
            </div>

            <div class="profile-right">
              <form class="mode" method="POST" action="/profile/{{profileUser._id}}/edit" autocomplete="off">
                <div class="field">
                  <div class="label">First Name</div>
                  <input class="edit-input" type="text" name="firstName" value="{{profileUser.firstName}}" required>
                </div>

                <div class="field">
                  <div class="label">Last Name</div>
                  <input class="edit-input" type="text" name="lastName" value="{{profileUser.lastName}}" required>
                </div>

                <div class="field">
                  <div class="label">Role</div>
                  <div class="value">{{profileUser.displayRole}}</div>
                </div>

                <div class="field">
                  <div class="label">Email</div>
                  <input class="edit-input" type="email" name="email" value="{{profileUser.email}}" required>
                </div>

                <div class="field">
                  <div class="label">Password</div>
                  <input class="edit-input" type="password" name="password" placeholder="Enter new password">
                </div>

                <div class="field">
                  <div class="label">Description</div>
                  <textarea class="edit-input" name="description" rows="4">{{profileUser.description}}</textarea>
                </div>

                <div class="edit-actions">
                  <button class="btn-outline wide" type="submit">Save</button>
                  <button class="btn-outline wide" type="button" onclick="location.href='/profile/{{profileUser._id}}'">Cancel</button>
                </div>
              </form>
            </div>
          </div>

        {{else}}

          {{#if isOwner}}
            <div class="mode">
              <div class="owner-hero">
                <div class="owner-hero__band"></div>

                <div class="owner-hero__content">
                  <div class="owner-hero__avatar">
                    <img
                      id="avatarPreview"
                      class="profile-avatar profile-avatar--owner"
                      src="{{profileUser.profilePic}}"
                      alt="{{profileUser.fullName}}"
                    >
                  </div>

                  <div class="owner-hero__info">
                    <div class="p-name">{{profileUser.fullName}}</div>
                    <div class="p-role">{{profileUser.displayRole}}</div>

                    <div class="owner-email-row">
                      <span class="material-symbols-rounded owner-email-icon">mail</span>
                      <span>{{profileUser.email}}</span>
                    </div>

                    <div class="owner-desc">
                      {{#if profileUser.description}}
                        {{profileUser.description}}
                      {{else}}
                        No description added yet.
                      {{/if}}
                    </div>
                  </div>
                </div>
              </div>

              <div class="reservations-block">
                <h2 class="reservations-title">Your Reservations</h2>

                <div class="reservations-grid">
                  {{#if reservations.length}}
                    {{#each reservations}}
                      <div class="reservation-card">
                        <div class="reservation-accent"></div>
                        <div class="reservation-info">
                          <div class="reservation-room">{{roomLabel}}</div>
                          <div class="reservation-date">{{dateLabel}}</div>
                          <div class="reservation-time">{{timeLabel}}</div>
                        </div>
                      </div>
                    {{/each}}
                  {{else}}
                    <p class="no-reservations">No active reservations.</p>
                  {{/if}}
                </div>

                <div class="owner-actions-inline">
                  <button
                    class="icon-circle-btn"
                    type="button"
                    onclick="location.href='/profile/{{profileUser._id}}?edit=true'"
                    aria-label="Edit profile"
                  >
                    <span class="material-symbols-rounded">edit_square</span>
                  </button>

                  <form
                    id="deleteProfileForm"
                    method="POST"
                    action="/profile/{{profileUser._id}}/delete"
                    style="display:inline;"
                  >
                    <button
                      id="deleteBtn"
                      class="icon-circle-btn"
                      type="button"
                      aria-label="Delete account"
                    >
                      <span class="material-symbols-rounded">delete</span>
                    </button>
                  </form>

                  <button
                    id="closeBtn"
                    class="btn-outline wide close-btn-inline"
                    type="button"
                    onclick="history.back()"
                  >
                    Close
                  </button>
                </div>
              </div>
            </div>

          {{else}}
            <div class="outsider-view">

              <div class="outsider-header">
                <div class="outsider-avatar-wrap">
                  <img
                    id="avatarPreview"
                    class="outsider-avatar"
                    src="{{profileUser.profilePic}}"
                    alt="{{profileUser.fullName}}"
                  >
                </div>

                <div class="outsider-main">
                  <div class="outsider-name">{{profileUser.fullName}}</div>
                  <div class="outsider-role">{{profileUser.displayRole}}</div>

                  <div class="outsider-email">
                    <span class="material-symbols-rounded outsider-email-icon">mail</span>
                    <span>{{profileUser.email}}</span>
                  </div>
                </div>
              </div>

              <div class="outsider-bottom">
                <div class="outsider-content-row">
                  <div class="reservations-block outsider-reservations">
                    <h2 class="reservations-title">{{profileUser.firstName}}'s Reservations</h2>

                    {{#if reservations.length}}
                      <div class="reservations-grid reservations-grid--outsider">
                        {{#each reservations}}
                          <div class="reservation-card">
                            <div class="reservation-accent"></div>
                            <div class="reservation-info">
                              <div class="reservation-room">{{roomLabel}}</div>
                              <div class="reservation-date">{{dateLabel}}</div>
                              <div class="reservation-time">{{timeLabel}}</div>
                            </div>
                          </div>
                        {{/each}}
                      </div>
                    {{else}}
                      <p class="no-reservations">No active reservations.</p>
                    {{/if}}
                  </div>

                  <div class="outsider-description">
                    {{#if profileUser.description}}
                      {{profileUser.description}}
                    {{else}}
                      No description added yet.
                    {{/if}}
                  </div>
                </div>

                <div class="outsider-actions">
                  <button
                    id="closeBtn"
                    class="btn-outline outsider-close-btn"
                    type="button"
                    onclick="history.back()"
                  >
                    Close
                  </button>
                </div>
              </div>

            </div>
          {{/if}}

        {{/if}}
      </div>
    </main>
  </div>

  <script src="/js/profile.js"></script>
  <script src="/js/search.js"></script>
</body>
</html>