<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{pageTitle}}</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
  <link rel="stylesheet" href="/css/profile.css">
</head>

<body class="page page--profile">
  <div class="app-bg"></div>

  <div class="page-wrap">
    <aside class="side-nav">
      <div class="side-icons">
        <a href="/home" class="side-btn text-decoration-none">
          <span class="material-symbols-rounded">home</span>
        </a>

        <a href="/reserve" class="side-btn text-decoration-none">
          <span class="material-symbols-rounded">computer</span>
        </a>

        <a href="/support" class="side-btn text-decoration-none">
          <span class="material-symbols-rounded">report</span>
        </a>

        <a href="/notifications" class="side-btn text-decoration-none">
          <span class="material-symbols-rounded">notifications</span>
        </a>
      </div>

      <div class="side-brand">
        <img src="/img/logo.png" class="brand-logo" alt="Logo">
      </div>
    </aside>

    <main class="main-area">
      <div class="top-row">
        <div>
          <h1 class="page-title">{{pageTitle}}</h1>
          <p class="page-subtitle">Welcome to your account center</p>
        </div>

        <div class="search-wrap">
          <div class="search-pill">
            <span class="search-ico">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
              </svg>
            </span>
            <input type="text" id="labSearch" placeholder="Search for Labs here...">
          </div>
        </div>
      </div>

      <div
        class="profile-shell {{#if isEditMode}}profile-shell--owner{{else}}{{#if isOwner}}profile-shell--owner{{else}}profile-shell--outsider{{/if}}{{/if}}">
        {{#if isEditMode}}

        <div class="edit-view">
          <div class="edit-header">
            <div class="edit-avatar-wrap">
              <img
                id="avatarPreview"
                class="edit-avatar"
                src="{{profileUser.profilePic}}"
                alt="{{profileUser.fullName}}"
              >

              <label class="edit-avatar-overlay" for="avatarFile" aria-label="Change photo">
                <span class="material-symbols-rounded">photo_camera</span>
              </label>
            </div>

            <div class="edit-header-main">
              <div class="edit-header-name">{{profileUser.fullName}}</div>
              <div class="edit-header-role">{{profileUser.displayRole}}</div>
            </div>
          </div>

          <div class="edit-bottom">
            <div class="edit-bottom-grid">
              <div class="edit-form-col">
                <form
                  id="editProfileForm"
                  class="edit-form"
                  method="POST"
                  action="/profile/{{profileUser._id}}/edit"
                  enctype="multipart/form-data"
                  autocomplete="off"
                >
                  <div class="edit-form-row edit-form-row--double">
                    <div class="field">
                      <div class="label">First Name</div>
                      <input class="edit-input" type="text" name="firstName" value="{{profileUser.firstName}}" required>
                    </div>

                    <div class="field">
                      <div class="label">Last Name</div>
                      <input class="edit-input" type="text" name="lastName" value="{{profileUser.lastName}}" required>
                    </div>
                  </div>

                  <div class="field">
                    <div class="label">Email</div>
                    <input class="edit-input" type="email" name="email" value="{{profileUser.email}}" required>
                  </div>

                  <div class="field">
                    <div class="label">Password</div>
                    <input class="edit-input" type="password" name="password" placeholder="Enter new password">
                  </div>

                  <div class="field">
                    <div class="label">Description</div>
                    <textarea class="edit-input edit-textarea" name="description" rows="4" maxlength="500">{{profileUser.description}}</textarea>
                  </div>

                  <input
                    id="avatarFile"
                    name="profilePic"
                    class="file-input"
                    type="file"
                    accept="image/*"
                    style="display: none;"
                  >
                </form>
              </div>

              <div class="edit-reservations-col">
                <div class="reservations-block edit-reservations">
                  <h2 class="reservations-title">Your Reservations</h2>

                  {{#if reservations.length}}
                  <div class="reservations-grid edit-reservations-grid">
                    {{#each reservations}}
                    <div class="reservation-card">
                      <div class="reservation-accent"></div>
                      <div class="reservation-info">
                        <div class="reservation-room">{{roomLabel}}</div>
                        <div class="reservation-date">{{dateLabel}}</div>
                        <div class="reservation-time">{{timeLabel}}</div>
                      </div>
                    </div>
                    {{/each}}
                  </div>
                  {{else}}
                  <p class="no-reservations">No active reservations.</p>
                  {{/if}}
                </div>
              </div>
            </div>

            <div class="edit-actions edit-actions--panel">
              <button class="btn-outline wide" type="submit" form="editProfileForm">Save</button>
              <a href="/profile/{{profileUser._id}}" class="btn-outline wide text-decoration-none" style="display: flex; justify-content: center; align-items: center;">
                Cancel
              </a>
            </div>
          </div>
        </div>

        {{else}}

        {{#if isOwner}}
        <div class="owner-view">
          <div class="owner-header">
            <div class="owner-avatar-wrap">
              <img
                id="avatarPreview"
                class="owner-avatar"
                src="{{profileUser.profilePic}}"
                alt="{{profileUser.fullName}}"
              >
            </div>

            <div class="owner-main">
              <div class="owner-name">{{profileUser.fullName}}</div>
              <div class="owner-role">{{profileUser.displayRole}}</div>

              <div class="owner-email">
                <span class="material-symbols-rounded owner-email-icon">mail</span>
                <span>{{profileUser.email}}</span>
              </div>
            </div>

            <div class="owner-header-actions">
              <button
                class="icon-circle-btn owner-header-btn"
                type="button"
                onclick="location.href='/profile/{{profileUser._id}}?edit=true'"
                aria-label="Edit profile"
              >
                <span class="material-symbols-rounded">edit_square</span>
              </button>

              <form
                id="deleteProfileForm"
                method="POST"
                action="/profile/{{profileUser._id}}/delete"
                class="owner-delete-form"
              >
                <button
                  id="deleteBtn"
                  class="icon-circle-btn owner-header-btn"
                  type="button"
                  aria-label="Delete account"
                  data-bs-toggle="modal"
                  data-bs-target="#deleteAccountModal"
                >
                  <span class="material-symbols-rounded">delete</span>
                </button>
              </form>

              <button
                id="logoutBtn"
                class="icon-circle-btn owner-header-btn"
                type="button"
                aria-label="Log out"
                data-bs-toggle="modal"
                data-bs-target="#logoutModal"
              >
                <span class="material-symbols-rounded">logout</span>
              </button>
            </div>
          </div>

          <div class="owner-bottom">
            <div class="owner-description-row">
              <div class="owner-description-spacer"></div>

              <div class="owner-description">
                {{#if profileUser.description}}
                {{profileUser.description}}
                {{else}}
                No description added yet.
                {{/if}}
              </div>
            </div>

            <div class="reservations-block owner-reservations">
              <h2 class="reservations-title">Your Reservations</h2>

              {{#if reservations.length}}
              <div class="reservations-grid reservations-grid--owner">
                {{#each reservations}}
                <div class="reservation-card">
                  <div class="reservation-accent"></div>
                  <div class="reservation-info">
                    <div class="reservation-room">{{roomLabel}}</div>
                    <div class="reservation-date">{{dateLabel}}</div>
                    <div class="reservation-time">{{timeLabel}}</div>
                  </div>
                </div>
                {{/each}}
              </div>
              {{else}}
              <p class="no-reservations">No active reservations.</p>
              {{/if}}
            </div>

            <div class="owner-actions">
              <a href="/home" class="btn btn-outline-light profile-close-btn">
                Close
              </a>
            </div>
          </div>
        </div>

        {{else}}
        <div class="outsider-view">
          <div class="outsider-header">
            <div class="outsider-avatar-wrap">
              <img
                id="avatarPreview"
                class="outsider-avatar"
                src="{{profileUser.profilePic}}"
                alt="{{profileUser.fullName}}"
              >
            </div>

            <div class="outsider-main">
              <div class="outsider-name">{{profileUser.fullName}}</div>
              <div class="outsider-role">{{profileUser.displayRole}}</div>

              <div class="outsider-email">
                <span class="material-symbols-rounded outsider-email-icon">mail</span>
                <span>{{profileUser.email}}</span>
              </div>
            </div>
          </div>

          <div class="outsider-bottom">
            <div class="outsider-description-row">
              <div class="outsider-description-spacer"></div>

              <div class="outsider-description">
                {{#if profileUser.description}}
                {{profileUser.description}}
                {{else}}
                No description added yet.
                {{/if}}
              </div>
            </div>

            <div class="reservations-block outsider-reservations">
              <h2 class="reservations-title">{{profileUser.firstName}}'s Reservations</h2>

              {{#if reservations.length}}
              <div class="reservations-grid reservations-grid--outsider">
                {{#each reservations}}
                <div class="reservation-card">
                  <div class="reservation-accent"></div>
                  <div class="reservation-info">
                    <div class="reservation-room">{{roomLabel}}</div>
                    <div class="reservation-date">{{dateLabel}}</div>
                    <div class="reservation-time">{{timeLabel}}</div>
                  </div>
                </div>
                {{/each}}
              </div>
              {{else}}
              <p class="no-reservations">No active reservations.</p>
              {{/if}}
            </div>

            <div class="outsider-actions">
              <a href="/home" class="btn btn-outline-light profile-close-btn">
                Close
              </a>
            </div>
          </div>
        </div>
        {{/if}}

        {{/if}}
      </div>
    </main>
  </div>

  {{#if isOwner}}
  <!--========================= LOGOUT MODAL =========================-->
  <div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content bg-dark text-white border border-light-subtle">
        <div class="modal-body text-center p-4">
          <h5 class="mb-3">Confirm Logout</h5>
          <p class="mb-4">Are you sure you want to log out?</p>
          <div class="d-flex justify-content-center gap-3">
            <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal">
              Cancel
            </button>
            <button class="btn btn-danger" type="button" onclick="window.location.href='/logout'">
              Logout
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--========================= DELETE ACCOUNT MODAL =========================-->
  <div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content bg-dark text-white border border-light-subtle">
        <div class="modal-body text-center p-4">
          <h5 class="mb-3">Delete Account</h5>
          <p class="mb-4">Are you sure you want to delete your account? This action cannot be undone.</p>
          <div class="d-flex justify-content-center gap-3">
            <button class="btn btn-outline-light" type="button" data-bs-dismiss="modal">
              Cancel
            </button>
            <button id="confirmDeleteBtn" class="btn btn-danger" type="button">
              Delete
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  {{/if}}

  <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1085;"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/profile.js"></script>
  <script src="/js/search.js"></script>
</body>

</html>