<!DOCTYPE html>
<html lang="en">
<head>
  <!--========================= META + LINKS =========================-->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IT Assist - Admin</title>

  <!--========================= VENDORS + FONTS =========================-->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0">

  <!--========================= PAGE STYLES =========================-->
  <link rel="stylesheet" href="/css/itassistadmin.css">
</head>

<body class="page page--itassistadmin">
  <!--========================= BACKGROUND LAYER =========================-->
  <div class="app-bg"></div>

  <!--========================= PAGE WRAPPER =========================-->
  <div class="page-wrap">

    <!--========================= SIDEBAR NAV =========================-->
    <aside class="side-nav">
      <div class="side-icons">
        <a href="/home" class="side-btn text-decoration-none">
          <span class="material-symbols-rounded">home</span>
        </a>

        <a href="/reserve" class="side-btn text-decoration-none">
          <span class="material-symbols-rounded">computer</span>
        </a>

        <a href="/support" class="side-btn text-decoration-none">
          <span class="material-symbols-rounded">report</span>
        </a>

        <a href="/notifications" class="side-btn text-decoration-none">
          <span class="material-symbols-rounded">notifications</span>
        </a>
      </div>

      <div class="side-brand">
        <img src="/img/logo.png" class="brand-logo" alt="Logo">
      </div>
    </aside>

    <!--========================= MAIN CONTENT =========================-->
    <main class="main-area">

      <!--========================= HEADER (TITLE + FILTER) =========================-->
      <div class="top-row">
        <div>
          <h1 class="page-title">IT Assist</h1>
          <p class="page-subtitle">View all unresolved tickets and reports</p>
        </div>

        <!------------------Filter Button------------------>
        <div class="filter-wrap">
          <button class="filter-btn" id="filterBtn" type="button" aria-label="Filters">
            <span class="material-symbols-rounded">tune</span>
          </button>

          <!--========================= FILTER POPUP =========================-->
          <div class="filter-pop" id="filterPop" hidden>
            <div class="filter-pop-head">
              <h3>Filter Tickets</h3>
            </div>

            <div class="filter-pop-body">
              <label class="filter-label" for="buildingFilter">Building</label>
              <select id="buildingFilter" class="filter-input">
                <option value="">All Buildings</option>
              </select>

              <label class="filter-label" for="roomFilter">Room</label>
              <select id="roomFilter" class="filter-input">
                <option value="">All Rooms</option>
              </select>

              <label class="filter-label" for="categoryFilter">Category</label>
              <select id="categoryFilter" class="filter-input">
                <option value="">All Categories</option>
              </select>
            </div>

            <div class="filter-pop-actions">
              <button type="button" class="pill-btn ghost-btn" id="clearFiltersBtn">Clear</button>
              <button type="button" class="pill-btn" id="applyFiltersBtn">Apply</button>
            </div>
          </div>
        </div>
      </div>

      <!--========================= TICKETS SHELL =========================-->
      <div class="tickets-shell">
        <div class="tickets-scroll">

          <!--========================= TICKET GRID =========================-->
          <div class="ticket-grid" id="ticketGrid"></div>

        </div>
      </div>

    </main>
  </div>

  <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1085;"></div>

  <!--========================= SERVER DATA =========================-->
  <script id="ticketData" type="application/json">
    {{{ticketsJson}}}
  </script>

  <!--========================= SCRIPTS =========================-->
  <script src="/js/itassistadmin.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>